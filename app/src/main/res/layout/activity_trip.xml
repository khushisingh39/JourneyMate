<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/anakiwa">
    <!--android:background="@drawable/background_image"-->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="@color/glacier">
        <TextView
            android:id="@+id/tvTripTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trip_title"
            android:fontFamily="times new roman"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:paddingBottom="10dp"
            android:textColor="@color/st_tropaz"/>


        <!-- Trip Details -->
        <!--        <ImageView-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_height="227dp"-->
        <!--            android:src="@drawable/trip_details1" />-->

        <TextView
            android:id="@+id/tvTripDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Trip details will appear here."
            android:textSize="14sp"
            android:padding="8dp"
            android:textColor="@color/san_juan2" />

        <!-- Book Trip Button -->
        <Button
            android:id="@+id/btnBookTrip"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:text="@string/book_trip"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:textSize="14sp"
            android:backgroundTint="@color/san_juan"
            android:textColor="@color/white" />

    </LinearLayout>
</LinearLayout>