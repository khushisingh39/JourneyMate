<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/anakiwa">

    <TextView
        android:id="@+id/forgot_your_password"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/forgotyourpassword"
        android:textSize="27sp"
        android:fontFamily="times new roman"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:textColor="@color/st_tropaz"
        android:layout_gravity="center_horizontal"/>
    <TextView
        android:id="@+id/help_you_get_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/help_you_get_back"
        android:textSize="12sp"
        android:fontFamily="times new roman"
        android:layout_marginBottom="10dp"
        android:textColor="@color/st_tropaz"
        android:layout_gravity="center_horizontal"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/glacier"
        android:padding="10dp"
        android:layout_marginTop="20dp">


        <EditText
            android:id="@+id/phone_number_input"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="@string/enter_your_phone_number"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_layout_view"
            android:textColorHint="@color/dark_gray"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:padding="10dp"
            android:inputType="phone"/>

        <Button
            android:id="@+id/send_otp_button"
            android:layout_width="150dp"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:text="@string/send_otp"
            android:layout_gravity="end"
            android:backgroundTint="@color/san_juan"
            android:textColor="@color/white"
            android:layout_marginBottom="20dp"/>

        <EditText
            android:id="@+id/otp_input"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="@string/enter_otp"
            android:background="@drawable/bg_layout_view"
            android:textColorHint="@color/dark_gray"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:padding="10dp"
            android:inputType="number"
            android:visibility="gone"/>

        <Button
            android:id="@+id/verify_otp_button"
            android:layout_width="150dp"
            android:layout_height="50dp"
            android:text="@string/verify_otp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:layout_gravity="end"
            android:backgroundTint="@color/san_juan"
            android:textColor="@color/white"
            android:visibility="gone"/>

        <!-- 🛠️ These fields must exist in XML -->
        <EditText
            android:id="@+id/new_password_input"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="@string/enter_new_password"
            android:inputType="textPassword"
            android:background="@drawable/bg_layout_view"
            android:textColor="@color/black"
            android:textColorHint="@color/dark_gray"
            android:textSize="14sp"
            android:padding="10dp"
            android:layout_marginBottom="10dp"
            android:visibility="gone"/>

        <EditText
            android:id="@+id/confirm_password_input"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="@string/confirm_password"
            android:inputType="textPassword"
            android:background="@drawable/bg_layout_view"
            android:textColor="@color/black"
            android:textColorHint="@color/dark_gray"
            android:textSize="14sp"
            android:padding="10dp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/reset_password_button"
            android:layout_width="150dp"
            android:layout_height="50dp"
            android:text="@string/reset_password"
            android:layout_gravity="end"
            android:backgroundTint="@color/san_juan"
            android:textColor="@color/white"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:textSize="14sp"
            android:padding="10dp"
            android:visibility="gone"/>

    </LinearLayout>
</LinearLayout>
